# LLM Provider Configuration
# Set the model you want litellm to use.
# Examples: 
# - openai/model_name
# - ollama/name
# - anthropic/model_name
LITELLM_MODEL="ollama/gemma4"
PET_NAME="Pixel"
MASTER_NAME="Master"

# API Keys (uncomment and set the ones you need)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For local models (like ollama or a local llama.cpp server)
# you typically don't need API keys. You might need to specify the api_base if it's non-standard:
# LITELLM_API_BASE=http://localhost:11434
